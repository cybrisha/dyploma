{
  "name": "auth-system-critical-infrastructure",
  "version": "1.0.0",
  "description": "Authentication System for Critical Infrastructure",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon backend/server.js",
    "dev:client": "cd frontend && npm run dev",
    "start": "node backend/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "seed": "node backend/scripts/seed.js",
    "clear-users": "node backend/scripts/clearUsers.js"
  },
  "keywords": ["authentication", "jwt", "rbac", "security"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "speakeasy": "^2.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
